# OpenAI-compatible endpoint. Ollama, vLLM, LM Studio and OpenAI all work.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=no-key
LLM_MODEL=qwen2.5:7b
# Embeddings for RAG chunks and reflection memory. "openai" uses {LLM_BASE_URL}/embeddings.
# Ollama: `ollama pull nomic-embed-text`. For local sentence-transformers set EMBED_BACKEND=st.
EMBED_BACKEND=openai
EMBED_MODEL=nomic-embed-text
